<div class="brand-row">
    <a class="brand" href="">Bitenovac</a>
    <button class="toggle" type="button" title="Navigation menu" aria-expanded="@(!collapseNavMenu)" @onclick="ToggleNavMenu">☰</button>
</div>

<nav class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <NavLink href="" Match="NavLinkMatch.All">Plan</NavLink>
</nav>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapsed" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

}
