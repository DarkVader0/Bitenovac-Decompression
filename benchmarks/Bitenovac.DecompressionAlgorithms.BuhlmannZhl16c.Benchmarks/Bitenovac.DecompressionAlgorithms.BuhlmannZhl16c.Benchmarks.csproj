        <ProjectReference Include="..\..\src\libraries\Bitenovac.DecompressionAlgorithms.Core\Bitenovac.DecompressionAlgorithms.Core.csproj"/>
        <ProjectReference Include="..\..\src\libraries\Bitenovac.DecompressionAlgorithms.Units\Bitenovac.DecompressionAlgorithms.Units.csproj"/>
    </ItemGroup>

</Project>
