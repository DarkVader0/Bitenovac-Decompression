<Project>
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>

    <!--
        Every managed project in the repository targets one framework, declared once here. A
        project that needs a different one sets TargetFramework in its own file, which wins
        because the project body is evaluated after this file.

        Multi-targeting is deliberately not supported: 'build/ci.sh verify' fails any project
        that declares TargetFrameworks, because a single TargetPath is what lets the pipeline
        locate an output without knowing the language or the framework. Repositories that mix
        languages need that indirection more, not less.
    -->
    <PropertyGroup>
        <RepositoryTargetFramework>net10.0</RepositoryTargetFramework>
        <TargetFramework Condition="'$(TargetFramework)' == '' AND '$(TargetFrameworks)' == ''">$(RepositoryTargetFramework)</TargetFramework>
    </PropertyGroup>

    <PropertyGroup>
        <IsLibrary Condition="'$(IsLibrary)' == '' AND ($(MSBuildProjectDirectory.Contains('src/libraries')) OR $(MSBuildProjectDirectory.Contains('src\libraries')))">true</IsLibrary>
        <IsLibrary Condition="'$(IsLibrary)' == ''">false</IsLibrary>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsLibrary)' == 'true'">

    </PropertyGroup>
    <PropertyGroup Condition="'$(IsLibrary)' == 'false'">

    </PropertyGroup>

    <PropertyGroup>
        <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.1.0</VersionPrefix>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsLibrary)' == 'true'">
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <Deterministic>true</Deterministic>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/DarkVader0/Bitenovac-Decompression</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Authors>Radivoje Milutinovic</Authors>
        <Company>Bitenovac</Company>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <PropertyGroup>
        <IsTestProject Condition="'$(IsTestProject)' == '' AND $(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
        <IsTestProject Condition="'$(IsTestProject)' == ''">false</IsTestProject>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    </PropertyGroup>

    <!--
        Coverage policy, enforced per project by build/ci.sh on every pull request that touches
        the project. Every project is held to full coverage by default; a project lowers the bar
        or opts out by setting these in its own file, which keeps the exception next to the code
        it excuses and visible in review:

            <PropertyGroup>
                <MinimumLineCoverage>90</MinimumLineCoverage>
                <MinimumBranchCoverage>80</MinimumBranchCoverage>
            </PropertyGroup>

        or, to drop out of the gate entirely:

            <PropertyGroup>
                <ExcludeFromCoverage>true</ExcludeFromCoverage>
            </PropertyGroup>
    -->
    <PropertyGroup>
        <MinimumLineCoverage Condition="'$(MinimumLineCoverage)' == ''">100</MinimumLineCoverage>
        <MinimumBranchCoverage Condition="'$(MinimumBranchCoverage)' == ''">100</MinimumBranchCoverage>

        <!-- Test projects do the measuring; they are not themselves measured. -->
        <ExcludeFromCoverage Condition="'$(ExcludeFromCoverage)' == '' AND '$(IsTestProject)' == 'true'">true</ExcludeFromCoverage>
        <ExcludeFromCoverage Condition="'$(ExcludeFromCoverage)' == ''">false</ExcludeFromCoverage>
    </PropertyGroup>
</Project>