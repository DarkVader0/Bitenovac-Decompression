<Project>
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

        <!--
            Roslyn embeds the absolute source path of every file into the PDB unless told
            otherwise, so building the same commit from two different working-copy paths (this
            machine vs. a CI worker vs. someone else's clone) produces byte-different output
            under an identical hash. Conditioned on CI rather than set unconditionally, because
            it also disables the debugger's "edit and continue" style source stepping locally.
        -->
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!--
        Every managed project targets one framework, declared here. A project that needs a
        different one sets TargetFramework in its own file, which wins: the project body is
        evaluated after this file.

        Multi-targeting is not supported. CI fails any project declaring TargetFrameworks,
        because an outer multi-targeting build reports no TargetPath to locate the output by.
    -->
    <PropertyGroup>
        <RepositoryTargetFramework>net10.0</RepositoryTargetFramework>
        <TargetFramework Condition="'$(TargetFramework)' == '' AND '$(TargetFrameworks)' == ''">$(RepositoryTargetFramework)</TargetFramework>
    </PropertyGroup>

    <PropertyGroup>
        <IsLibrary Condition="'$(IsLibrary)' == '' AND ($(MSBuildProjectDirectory.Contains('src/libraries')) OR $(MSBuildProjectDirectory.Contains('src\libraries')))">true</IsLibrary>
        <IsLibrary Condition="'$(IsLibrary)' == ''">false</IsLibrary>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsLibrary)' == 'true'">

    </PropertyGroup>
    <PropertyGroup Condition="'$(IsLibrary)' == 'false'">

    </PropertyGroup>

    <PropertyGroup>
        <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.1.0</VersionPrefix>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsLibrary)' == 'true'">
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <Deterministic>true</Deterministic>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/DarkVader0/Bitenovac-Decompression</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Authors>Radivoje Milutinovic</Authors>
        <Company>Bitenovac</Company>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <PropertyGroup>
        <IsTestProject Condition="'$(IsTestProject)' == '' AND $(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
        <IsTestProject Condition="'$(IsTestProject)' == ''">false</IsTestProject>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

        <!--
            Whether a cache hit on this test project may serve its stored result instead of
            re-running it. True by default: a test project's hash already covers everything it
            depends on, so "same hash" genuinely means "same result" for anything hermetic. A
            project whose result depends on something the hash cannot see — a live service, the
            network, wall-clock time — should set this to false in its own file.
        -->
        <CacheTestResults Condition="'$(CacheTestResults)' == ''">true</CacheTestResults>
    </PropertyGroup>

    <!--
        Coverage policy, read per project by CI. Full coverage by default; a project lowers the
        bar or opts out in its own file, keeping the exception next to the code it excuses:

            <PropertyGroup>
                <MinimumLineCoverage>90</MinimumLineCoverage>
                <MinimumBranchCoverage>80</MinimumBranchCoverage>
            </PropertyGroup>

        or, to drop out of the gate entirely:

            <PropertyGroup>
                <ExcludeFromCoverage>true</ExcludeFromCoverage>
            </PropertyGroup>
    -->
    <PropertyGroup>
        <MinimumLineCoverage Condition="'$(MinimumLineCoverage)' == ''">100</MinimumLineCoverage>
        <MinimumBranchCoverage Condition="'$(MinimumBranchCoverage)' == ''">100</MinimumBranchCoverage>

        <!-- Test projects do the measuring; they are not themselves measured. -->
        <ExcludeFromCoverage Condition="'$(ExcludeFromCoverage)' == '' AND '$(IsTestProject)' == 'true'">true</ExcludeFromCoverage>
        <ExcludeFromCoverage Condition="'$(ExcludeFromCoverage)' == ''">false</ExcludeFromCoverage>
    </PropertyGroup>
</Project>